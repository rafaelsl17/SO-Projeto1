#!/bin/bash

# Definição de estilos ANSI
BOLD="\e[1m"
RESET="\e[0m"

# Variáveis com valores por defeito
MODE="" 
FILE="$HOME/.pdb"
IGNORE_PATTERN=""
SYSLOG_FLAG=0

# Menu de ajuda
show_help() {
    echo -e "Opção inválida ou incompleta.
    ${BOLD}Uso${RESET}: ./vp [-p <dir1... > | -v] [-f <ficheiro>] [-e <ignore_pattern>] [-s]
    -p      ${BOLD}Protege${RESET} e guarda informação acerca de um ou mais diretórios
    -v      ${BOLD}Verifica${RESET} alterações em ficheiros desde que foram protegidos
    -f      Indicação do nome do ficheiro onde a base de dados será guardada. (Por defeito será tmp/.pdb)
    -e      ${BOLD}Permite${RESET} a exclusão de ficheiros voláteis (ex. *.tmp, *.log,/tmp/*)
    -s      Emissão de alertas de alta prioridade para o sistema de logging"
}

# Recebe uma lista de ficheiros e guarda-os na base de dados
processar_ficheiros() {
    while read -r ficheiro; do
        read user group size perm <<< $(stat -c "%U %G %s %a" "$ficheiro")
        hash=$(sha256sum "$ficheiro" | awk '{print $1}')
        echo "$ficheiro Informação atual: USER=$user, GROUP=$group, SIZE=$size, PERM=$perm, SHA256=$hash" >> "$FILE"
        echo "A processar: $ficheiro"
    done
}

while getopts ":pvf:e:s" opt; do
    case ${opt} in
        p ) 
            if [[ "$MODE" == "v" ]]; then
                echo -e "Não pode usar simultaneamente os switches -v e -p"
                exit 2
            fi
            MODE="p"
            ;;
        v ) 
            if [[ "$MODE" == "p" ]]; then
                echo -e "Não pode usar simultaneamente os switches -p e -v"
                exit 2
            fi
            MODE="v"
            ;;
        f ) FILE="$OPTARG" ;;
        e ) IGNORE_PATTERN="$OPTARG" ;;
        s ) SYSLOG_FLAG=1 ;;
        \? ) show_help; exit 1 ;;
        : )  echo "A opção -$OPTARG requer um argumento."; show_help; exit 1 ;;
    esac
done

shift $((OPTIND -1))

#----------------------------------------------------------------------------------

if [[ "$MODE" == "p" ]]; then
    if [[ $# -eq 0 ]]; then
        echo "Erro: O modo de proteção (-p) requer pelo menos um diretório."
        exit 1
    fi
    echo "A proteger os diretórios: $@"
    echo "Ficheiro DB: $FILE"
    
    echo "Diretorios protegidos: $*" > "$FILE"

    for DIR in "$@"; do
        if [[ ! -d "$DIR" ]]; then
            echo "Aviso: '$DIR' não é um diretório válido. A ignorar."
            exit 2
        fi

        if [[ -n "$IGNORE_PATTERN" ]]; then
            find "$DIR" -type f ! -name "$IGNORE_PATTERN" | processar_ficheiros
        else
            find "$DIR" -type f | processar_ficheiros
        fi
    done
    echo "Base de dados $FILE criada com sucesso."

elif [[ -z "$MODE" || "$MODE" == "v" ]]; then
    if [[ ! -f "$FILE" ]]; then
        echo "Erro: Ficheiro de base de dados '$FILE' não encontrado."
        exit 1
    fi

    # Devolve a informação atual de um ficheiro (mesmo formato do modo de proteção)
    obter_info() {
        read user group size perm <<< $(stat -c "%U %G %s %a" "$1")
        hash=$(sha256sum "$1" | awk '{print $1}')
        echo "USER=$user, GROUP=$group, SIZE=$size, PERM=$perm, SHA256=$hash"
    }

    # Lista os ficheiros de um diretório (com ou sem ignore pattern, como no modo de proteção)
    listar_ficheiros() {
        if [[ -n "$IGNORE_PATTERN" ]]; then
            find "$1" -type f ! -name "$IGNORE_PATTERN"
        else
            find "$1" -type f
        fi
    }

    # Diretórios protegidos (primeira linha do ficheiro)
    read -r linha1 < "$FILE"
    dirs_protegidos=${linha1#"Diretorios protegidos: "}

    verificados=0
    modificado=0
    apagado=0
    novo=0

    # Ficheiro temporário com os ficheiros da base de dados (para detetar os novos)
    lista_db=$(mktemp)

    # 1. Modificados e apagados (lê a base de dados, saltando a primeira linha)
    while read -r ficheiro resto; do
        info_inicial=${resto#Informação atual: }
        echo "$ficheiro" >> "$lista_db"

        if [[ ! -f "$ficheiro" ]]; then
            echo "$ficheiro foi APAGADO"
            echo "    Informação inicial:   $info_inicial"
            echo "    Informação atual:     [Ficheiro não encontrado no sistema]"
            echo "--------------------------------------------------------------------------------"
            ((apagado++))
        else
            info_atual=$(obter_info "$ficheiro")

            if [[ "$info_inicial" != "$info_atual" ]]; then
                # Separa os campos da informação inicial (1) e atual (2)
                IFS=', ' read -r user1 group1 size1 perm1 hash1 <<< "$info_inicial"
                IFS=', ' read -r user2 group2 size2 perm2 hash2 <<< "$info_atual"

                motivo=""
                [[ "$user1" != "$user2" || "$group1" != "$group2" ]] && motivo="Posse"
                [[ "$size1" != "$size2" || "$hash1" != "$hash2" ]] && motivo="${motivo:+$motivo e }Conteúdo"
                [[ "$perm1" != "$perm2" ]] && motivo="${motivo:+$motivo e }Permissões"

                echo "$ficheiro foi MODIFICADO (Alteração de $motivo)"
                echo "    Informação inicial:   $info_inicial"
                echo "    Informação atual:     $info_atual"
                echo "--------------------------------------------------------------------------------"
                ((modificado++))
            fi
        fi
        ((verificados++))
    done < <(tail -n +2 "$FILE")

    # 2. Novos (procura nos diretórios protegidos ficheiros que não estão na base de dados)
    for d in $dirs_protegidos; do
        if [[ -d "$d" ]]; then
            while read -r f; do
                if ! grep -qxF "$f" "$lista_db"; then
                    echo "$f é NOVO"
                    echo "    Informação atual:     $(obter_info "$f")"
                    echo "--------------------------------------------------------------------------------"
                    ((novo++))
                fi
            done < <(listar_ficheiros "$d")
        fi
    done

    rm -f "$lista_db"

    echo "Resumo da Verificação: $verificados verificados | $modificado Modificado | $apagado Apagado | $novo Novo"
fi
