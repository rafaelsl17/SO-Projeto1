#!/bin/bash

# Definição de estilos ANSI
BOLD="\e[1m"
RESET="\e[0m"

# Variáveis com valores por defeito
MODE="" 
FILE="~/.pdb"
IGNORE_PATTERN=""
SYSLOG_FLAG=0

# Menu de ajuda
show_help() {
    echo -e "Opção inválida ou incompleta.
    ${BOLD}Uso${RESET}: ./vp [-p <dir1... > | -v] [-f <ficheiro>] [-e <ignore_pattern>] [-s]
    -p      ${BOLD}Protege${RESET} e guarda informação acerca de um ou mais diretórios
    -v      ${BOLD}Verifica${RESET} alterações em ficheiros desde que foram protegidos
    -f      Indicação do nome do ficheiro onde a base de dados será guardada. (Por defeito será tmp/.pdb)
    -e      ${BOLD}Permite${RESET} a exclusão de ficheiros voláteis (ex. *.tmp, *.log,/tmp/*)
    -s      Emissão de alertas de alta prioridade para o sistema de logging"
}

# Recebe uma lista de ficheiros e guarda-os na base de dados
processar_ficheiros() {
    # O while read vai ler o ficheiro que vier do 'find'
    while read -r ficheiro; do

        # para cada ficheiro usamos stat,só uma vez, para extrair tudo, onde:
        # %U = Dono, %G = Grupo, %s = Tamanho, %a = Permissões em octal
        # O comando read distribui os 4 resultados logo pelas 4 variaveis
        read user group size perm <<< $(stat -c "%U %G %s %a" "$ficheiro")
        
        # Calcular o Hash SHA256 (256bits hash table) 
        hash=$(sha256sum "$ficheiro" | awk '{print $1}')
        
        # guardar na base de dados ($FILE) com a formatação correta
        echo "$ficheiro Informação atual: USER=$user, GROUP=$group, SIZE=$size, PERM=$perm, SHA256=$hash" >> "$FILE"
        
        echo "A processar: $ficheiro"
    done
}

# A string "pvf:e:s" define os switches aceites. 
# Os ":" à frente do f e do e indicam que precisam de um argumento a seguir.
while getopts ":pvf:e:s" opt; do
    case ${opt} in
        p ) 
            if [[ "$MODE" == "v" ]]; then
                echo -e "Não pode usar simultaneamente os switches -v e -p"
                exit 2
            fi
            MODE="p"
            ;;
        v ) 
            if [[ "$MODE" == "p" ]]; then
                echo -e "Não pode usar simultaneamente os switches -p e -v"
                exit 2
            fi
            MODE="v"
            ;;
        f ) 
            FILE="$OPTARG" # OPTARG guarda o argumento passado após o -f
            ;;
        e ) 
            IGNORE_PATTERN="$OPTARG"
            ;;
        s ) 
            SYSLOG_FLAG=1
            ;;
        \? ) # Opção não reconhecida
            show_help
            exit 1
            ;;
        : )  # Faltou o argumento para uma opção (ex: usou -f mas não indicou o ficheiro)
            echo "A opção -$OPTARG requer um argumento."
            show_help
            exit 1
            ;;
    esac
done

# Remove os argumentos processados pelo getopts (as flags)
# Deixa apenas os argumentos soltos (ex: a lista de diretórios) na variável $@
shift $((OPTIND -1))


#----------------------------------------------------------------------------------

if [[ "$MODE" == "p" ]]; then
    if [[ $# -eq 0 ]]; then
        echo "Erro: O modo de proteção (-p) requer pelo menos um diretório."
        exit 1
    fi
    echo "A proteger os diretórios: $@"
    echo "Ficheiro DB: $FILE"
    
    echo "Diretorios protegidos: $*" > "$FILE"

    # ter a certeza que o que está em $@ é uma diretoria
    for DIR in "$@"; do

        if [[ ! -d "$DIR" ]]; then
            echo "Aviso: '$DIR' não é um diretório válido. A ignorar."
            exit 2
        fi

        # O comando 'find' passa pela diretoria atual ($DIR) à procura de ficheiros (-type f).
        # e dá como argumento para a função processar_ficehiros esses mesmos ficheiros através do pipe.
        # O comando '! -name "$IGNORE_PATTERN"' serve para ignorar ficheiros de um tipo especificado na variável $IGNORE_PATTERN 

        if [[ -n "$IGNORE_PATTERN" ]]; then
            # Se a variável de ignorar não estiver vazia, fazemos o find completo
            find "$DIR" -type f ! -name "$IGNORE_PATTERN" | processar_ficheiros
        else
            # Se não houver ignore_pattern, fazemos o find simples
            find "$DIR" -type f | processar_ficheiros
        fi

    done
    echo "Base de dados $FILE criada com sucesso."

elif [[ -z "$MODE" || "$MODE" == "v" ]]; then
    # MODO DE VERIFICAÇÃO (Por omissão ou com -v)
    echo "A verificar..."
    echo "Ficheiro DB a ler: $FILE"
fi

