#!/bin/bash

tempo_inicio=$SECONDS

# Definição de estilos ANSI
BOLD="\e[1m"
RESET="\e[0m"

# Variáveis com valores por defeito
# Usamos $HOME/.pdb e não o sugerido tmp/.pdb pois 
# o /tmp é público e não persistente, deixando com que outros utilizadores do sistema tivessem acesso aos metadados e que a BD desaparecesse após reboot

MODE="" 
FILE="$HOME/.pdb"
IGNORE_PATTERN=""
SYSLOG_FLAG=0

# mensagens de ajuda de como usar corretamente os códigos
show_help() {
    echo -e "Uso: $0 [-p <dir1...> | -v] [-f <ficheiro>] [-e <ignore_pattern>] [-s]
    -p      ${BOLD}Protege${RESET} e guarda informação acerca de um ou mais diretórios
    -v      ${BOLD}Verifica${RESET} alterações em ficheiros desde que foram protegidos
    -f      Indicação do nome do ficheiro onde a base de dados será guardada. (Por defeito será $HOME/.pdb)
    -e      ${BOLD}Permite${RESET} a exclusão de ficheiros voláteis (ex. *.tmp, *.log,/tmp/*) da proteção e verificação
    -s      Emissão de alertas de alta prioridade para o sistema de logging usando o logger"
}

# alerta para o syslog se a flag -s foi ativada
send_syslog() {
    if [[ $SYSLOG_FLAG -eq 1 ]]; then
        logger -p auth.alert -t vp -- "$1"
    fi
}

# Recebe uma lista de ficheiros e guarda-os na base de dados
processar_ficheiros() {
    while read -r ficheiro; do
        # se o ficheiro for igual ao da própria base de dados, ignora
        if [[ "$ficheiro" -ef "$FILE" ]]; then continue; fi
        
        # Aplica o padrão de exclusão (-e) (se existir)
        if [[ -n "$IGNORE_PATTERN" ]]; then
            # Extrai apenas o nome do ficheiro sem o caminho todo
            nome_ficheiro=$(basename "$ficheiro")
            
            # Compara o padrão de exclusão com o caminho completo do ficheiro($ficheiro) e
            # também com o nome final (usando o basename), fazendo com que o utilizador
            # possa escrever o caminho completo ou só um padrão global (ex: *.log)
            # 'continue' salta o ficheiro se estiver certo
            if [[ "$ficheiro" == $IGNORE_PATTERN || "$nome_ficheiro" == $IGNORE_PATTERN ]]; then
                continue
            fi
        fi

        # 'stat' devolve uma linha com 5 metadados separados por espaço e o operador <<< (here-string)
        # manda essa linha para o comando read, que por sua vez distribui as 5 palavras pelas
        # 5 variáveis distintas de uma só vez, adicionando %Y para a data de modificação
        
        # O sha256sum gera o hash mas também inclui o nome do ficheiro no output
        # o 'awk' recebe isso do pipe '|'  e guarda apenas a 1ª coluna (o hash limpo)
        read user group size perm mtime <<< $(stat -c "%U %G %s %a %Y" "$ficheiro")
        hash=$(sha256sum "$ficheiro" | awk '{print $1}')
        
        echo "$ficheiro Informação atual: USER=$user, GROUP=$group, SIZE=$size, PERM=$perm, MTIME=$mtime, SHA256=$hash" >> "$FILE"
    done
}

# Processamento de Opções (getopts)
# O getopts pára no primeiro argumento que não é uma opção (ex.: um diretório).
# Por isso, o ciclo exterior guarda esse argumento em DIRS e volta a chamar o
# getopts, para que possamos guardar vários diretórios
# (ex.: ./vp -p dir1 dir2 -e "*.log").
DIRS=()
while (( OPTIND <= $# )); do
    while getopts ":pvf:e:s" opt; do
        case ${opt} in
            p ) 
                if [[ "$MODE" == "v" ]]; then
                    echo "Erro: Não pode usar simultaneamente os switches -p e -v"
                    show_help; exit 1
                fi
                MODE="p"
                ;;
            v ) 
                if [[ "$MODE" == "p" ]]; then
                    echo "Erro: Não pode usar simultaneamente os switches -p e -v"
                    show_help; exit 1
                fi
                MODE="v"
                ;;
            f ) FILE="$OPTARG" ;;
            e ) IGNORE_PATTERN="$OPTARG" ;;
            s ) SYSLOG_FLAG=1 ;;
            \? ) echo "Opção inválida: -$OPTARG"; show_help; exit 1 ;;
            : )  echo "A opção -$OPTARG requer um argumento."; show_help; exit 1 ;;
        esac
    done
    # Argumento que não é opção: é um diretório
    if (( OPTIND <= $# )); then
        DIRS+=("${!OPTIND}")
        ((OPTIND++))
    fi
done

# Os diretórios passam a ser os parâmetros posicionais ($@)
set -- "${DIRS[@]}"

# Por defeito, o comando é executado no modo de verificação
if [[ -z "$MODE" ]]; then
    MODE="v"
fi

# MODO DE PROTEÇÃO
if [[ "$MODE" == "p" ]]; then
    if [[ $# -eq 0 ]]; then
        echo "Erro: O modo de proteção (-p) requer pelo menos um diretório."
        show_help; exit 1
    fi
    
    # Validar se os diretórios introduzidos são válidos
    for DIR in "$@"; do
        if [[ ! -d "$DIR" ]]; then
            echo "Erro: '$DIR' não é um diretório válido."
            show_help; exit 1
        fi
    done

    # Remove a BD anterior caso exista (pode ser read-only, e não dá para escrever)
    # O -f força a remoção e evita que o comando dê erro caso o ficheiro ainda não exista.
    rm -f "$FILE"

    # Cria a base de dados guardando configurações nas primeiras 2 linhas
    echo "Pattern: $IGNORE_PATTERN" > "$FILE"
    echo "Diretorios: $*" >> "$FILE"

    # Envia os ficheiros encontrados para a função que processa e guarda
    for DIR in "$@"; do
        find "$DIR" -type f | processar_ficheiros
    done
    
    # Torna a BD só de leitura (apenas o dono pode ler)
    # (evita corrupção de dados)
    chmod 400 "$FILE"

    # Calcula o número de ficheiros guardados (descontando o cabeçalho de 2 linhas)
    total_ficheiros=$(($(wc -l < "$FILE") - 2))
    
    echo "Base de dados de proteção $FILE criada com sucesso."
    echo "Ficheiros processados: $total_ficheiros | Diretórios protegidos: $*"


# MODO DE VERIFICAÇÃO
elif [[ "$MODE" == "v" ]]; then
    if [[ ! -f "$FILE" ]]; then
        echo "Erro: Ficheiro com a base de dados '$FILE' não encontrado."
        show_help; exit 1
    fi

    # Função simples para gerar a string de um ficheiro atual para comparar com a BD
    obter_info() {
        read user group size perm mtime <<< $(stat -c "%U %G %s %a %Y" "$1")
        hash=$(sha256sum "$1" | awk '{print $1}')
        echo "USER=$user, GROUP=$group, SIZE=$size, PERM=$perm, MTIME=$mtime, SHA256=$hash"
    }

    # Lê as duas primeiras linhas da BD para recuperar as definições
    {
        read -r linha1
        read -r linha2
    } < "$FILE"
    
    db_pattern=${linha1#"Pattern: "}
    dirs_protegidos=${linha2#"Diretorios: "}

    # Se não foi passado -e na linha de comandos, usa o da base de dados
    if [[ -z "$IGNORE_PATTERN" ]]; then
        IGNORE_PATTERN="$db_pattern"
    fi

    verificados=0
    modificado=0
    apagado=0
    novo=0
    linha_atual=0

    lista_db=$(mktemp)

    # 1. Modificados e apagados (Lê a BD e usa o contador para ignorar o cabeçalho)
    while read -r ficheiro resto; do
        ((linha_atual++))
        
        # Se estiver nas linhas 1 ou 2 (o cabeçalho), ignora e passa à próxima iteração
        if [[ $linha_atual -le 2 ]]; then
            continue
        fi

        info_inicial=${resto#Informação atual: }
        
        echo "$ficheiro" >> "$lista_db"

        if [[ ! -f "$ficheiro" ]]; then
            echo "$ficheiro foi APAGADO"
            echo "    Informação inicial:   $info_inicial"
            echo "    Informação atual:     [Ficheiro não encontrado no sistema]"
            echo "--------------------------------------------------------------------------------"
            send_syslog "Ficheiro APAGADO: $ficheiro"
            ((apagado++))
        else
            info_atual=$(obter_info "$ficheiro")

            # Compara os metadados e hash para verificar diferenças para ver se sofreram alterações
            if [[ "$info_inicial" != "$info_atual" ]]; then
                IFS=', ' read -r user1 group1 size1 perm1 mtime1 hash1 <<< "$info_inicial"
                IFS=', ' read -r user2 group2 size2 perm2 mtime2 hash2 <<< "$info_atual"

                motivo=""
                [[ "$user1" != "$user2" || "$group1" != "$group2" ]] && motivo="Posse"
                [[ "$size1" != "$size2" || "$hash1" != "$hash2" ]] && motivo="${motivo:+$motivo e }Conteúdo"
                [[ "$perm1" != "$perm2" ]] && motivo="${motivo:+$motivo e }Permissões"
                [[ "$mtime1" != "$mtime2" ]] && motivo="${motivo:+$motivo e }Data de modificação"

                echo "$ficheiro foi MODIFICADO (Alteração de $motivo)"
                echo "    Informação inicial:   $info_inicial"
                echo "    Informação atual:     $info_atual"
                echo "--------------------------------------------------------------------------------"
                send_syslog "Ficheiro MODIFICADO ($motivo): $ficheiro"
                ((modificado++))
            fi
        fi
        ((verificados++))
    done < "$FILE"

    # 2. Novos (Percorre os diretórios originais e usa o grep para verificar se 
    # o ficheiro não existe na lista temporária (lista_db=$(mktemp)) gerada no passo anterior)
    for d in $dirs_protegidos; do
        if [[ -d "$d" ]]; then
            while read -r f; do
                if [[ "$f" -ef "$FILE" ]]; then continue; fi
                
                # Exclusão de voláteis
                if [[ -n "$IGNORE_PATTERN" ]]; then
                    # Extrai apenas o nome do ficheiro sem o caminho todo
                    nome_ficheiro=$(basename "$f")
                    
                    # Verifica o caminho completo ou apenas o nome do ficheiro
                    if [[ "$f" == $IGNORE_PATTERN || "$nome_ficheiro" == $IGNORE_PATTERN ]]; then
                        continue
                    fi
                fi

                if ! grep -qxF "$f" "$lista_db"; then
                    echo "$f é NOVO"
                    echo "    Informação atual:     $(obter_info "$f")"
                    echo "--------------------------------------------------------------------------------"
                    send_syslog "Ficheiro NOVO: $f"
                    ((novo++))
                fi
            done < <(find "$d" -type f)
        fi
    done
    
    rm -f "$lista_db" # remove permanentemente o ficheiro temporário

    echo "Resumo da Verificação: $verificados verificados | $modificado Modificado | $apagado Apagado | $novo Novo"
    
    # ENVIO PARA O SYSLOG (-s)
    if (( modificado + apagado + novo > 0 )); then
        send_syslog "Resumo da Verificação: $verificados verificados | $modificado Modificado | $apagado Apagado | $novo Novo"
    fi
    
    echo "Tempo total de análise: $((SECONDS - tempo_inicio)) segundos."
fi
